# ---- Core ----
NODE_ENV=development
PORT=3000

# ---- Compose (used by compose.yml, not read by the app) ----
# Public hostname for TLS (Caddy). Only used when the caddy service is enabled.
DOMAIN=sso.example.org
# GitHub owner of the GHCR image (e.g. your GitHub username). Required.
GHCR_OWNER=your-org
# Compose profile for the bundled Caddy reverse proxy. Set to empty to skip
# Caddy and front the app with your own proxy (it listens on 127.0.0.1:3000).
COMPOSE_PROFILES=proxy

# Public URL of this service. Must be reachable by tools and browsers.
# In production this must be an https URL.
ISSUER_URL=http://localhost:3000

# Random string used to sign cookies. Generate one with: npm run gen:secrets
COOKIE_SECRET=change-me

# Where runtime data (JWKS key, audit logs) is stored. Keep this out of git.
DATA_DIR=./data

# Comma-separated list of email domains allowed to log in.
# Codes will only be sent to addresses matching one of these.
ALLOWED_EMAIL_DOMAINS=college.edu

# ---- Branding / email ----
SERVICE_NAME=College SSO
FROM_ADDRESS=no-reply@example.org

# console: prints the code to stdout (dev only)
# smtp:    sends via SMTP (use SES SMTP settings)
MAIL_DRIVER=console

# Used when MAIL_DRIVER=smtp (SES SMTP endpoint, port 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- One-time codes ----
CODE_TTL_SECONDS=300
CODE_LENGTH=6
MAX_CODE_ATTEMPTS=5

# ---- Rate limiting ----
RATE_LIMIT_SEND_PER_EMAIL=3
RATE_LIMIT_SEND_WINDOW_MS=300000
RATE_LIMIT_SEND_PER_IP=10
RATE_LIMIT_IP_WINDOW_MS=300000
LOCKOUT_MS=900000

# ---- Sessions / tokens (seconds) ----
SESSION_TTL_SECONDS=604800
ACCESS_TOKEN_TTL_SECONDS=3600
ID_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=1209600
AUTH_CODE_TTL_SECONDS=600
GRANT_TTL_SECONDS=2592000
INTERACTION_TTL_SECONDS=600

# ---- Clients ----
# Path to the JSON file listing OIDC clients (see clients.example.json).
CLIENTS_PATH=./clients.json

# ---- Audit logging ----
AUDIT_LOG_DIR=./data
AUDIT_RETENTION_DAYS=30
